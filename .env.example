# ==============================================================================
# SKILL SETU - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Backend & Cloud Functions)
# ------------------------------------------------------------------------------
# For local / standalone server execution with Firebase Admin:
FIREBASE_PROJECT_ID=skill-setu-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@skill-setu-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=skill-setu-app.firebasestorage.app

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (AI Skill-Gap & Quiz Generation)
# ------------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. FRONTEND ENVIRONMENT VARIABLES (Vite - client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=skill-setu-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skill-setu-app
VITE_FIREBASE_STORAGE_BUCKET=skill-setu-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
