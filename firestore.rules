rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // users/{uid}
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // skillCategories/{id} (skills per track)
    match /skillCategories/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // courses/{id} (course catalogue)
    match /courses/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // assessments/{id} (baseline results, linked to uid)
    match /assessments/{id} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // skillGapReports/{id} (priority-ranked gaps, linked to uid)
    match /skillGapReports/{id} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // recommendations/{id} (ordered learning path, linked to uid)
    match /recommendations/{id} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // quizQuestions/{id} (generated MCQs with answer + explanation)
    match /quizQuestions/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // quizAttempts/{id} (scores, per-question results, linked to uid)
    match /quizAttempts/{id} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // progressLogs/{id} (updated skill levels over time, linked to uid)
    match /progressLogs/{id} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
  }
}
